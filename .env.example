# Copy this file to .env before running `docker compose up --build`.
# Every value below has a sensible default baked into docker-compose.yml,
# so the app runs with zero changes. Override here only if you need to.

# ---- Postgres ----
POSTGRES_USER=citegraph
POSTGRES_PASSWORD=citegraph
POSTGRES_DB=citegraph
POSTGRES_PORT=5432

# ---- Go API gateway ----
GATEWAY_PORT=8080
# Secret used to sign JWTs. Change this if you expose the app to anyone else.
JWT_SECRET=change-me-in-real-use-but-fine-for-local-demo
# How long a login stays valid.
JWT_TTL_HOURS=72
# Simple per-user rate limits (requests per minute) on the heavy endpoints.
RATE_LIMIT_UPLOAD_PER_MIN=10
RATE_LIMIT_ASK_PER_MIN=30

# ---- Python agent service ----
AGENT_GRPC_PORT=50051
AGENT_HTTP_PORT=8000

# ---- Ollama (local LLM) ----
# The gateway/agent talk to Ollama at this address. When everything runs in
# Docker Compose, "ollama" is the service name. If you run Ollama on your host
# instead, set this to http://host.docker.internal:11434.
OLLAMA_BASE_URL=http://ollama:11434
# Small model that runs on a normal laptop. Pulled automatically on first start.
OLLAMA_MODEL=llama3.2:3b

# ---- Embeddings (local, no API) ----
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ---- Retrieval / verification tuning ----
CHUNK_SIZE_TOKENS=350
CHUNK_OVERLAP_TOKENS=60
RETRIEVAL_TOP_K=6
# Below this cosine similarity we treat the papers as not addressing the question.
RETRIEVAL_MIN_SIMILARITY=0.25
# A citation must reach at least this support score to be shown.
CITATION_SUPPORT_THRESHOLD=0.45

# ---- Seeded demo account (printed in the README) ----
DEMO_EMAIL=demo@citegraph.dev
DEMO_PASSWORD=demo1234

# ---- Frontend ----
FRONTEND_PORT=5173
